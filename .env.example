ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 알림 시스템 (선택) — 아래를 하나도 설정하지 않으면 자동으로 Mock 모드로 동작
# (실제 전송 없이 /api/alerts 로그에만 기록됨)

# Slack: Slack 앱의 Incoming Webhook URL
SLACK_WEBHOOK_URL=

# 이메일: SMTP 서버 정보
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# CVE 실시간 조회 (선택) — 없어도 NVD 공개 API를 그대로 쓸 수 있으나 요청 한도가
# 30초당 5건으로 제한됨. https://nvd.nist.gov/developers/request-an-api-key 에서 무료 발급,
# 설정 시 30초당 50건으로 늘어남.
NVD_API_KEY=

# IoC 위협 인텔리전스 실조회 (선택, 둘 다 없으면 지금까지처럼 AI 판정만 사용)
# AbuseIPDB: IP 평판 조회, https://www.abuseipdb.com/account/api 에서 무료 발급 (일 1,000건)
ABUSEIPDB_API_KEY=
# AlienVault OTX: IP/도메인/해시 커뮤니티 IOC 조회, https://otx.alienvault.com/api 에서 무료 발급
OTX_API_KEY=

# AWS CloudTrail 연동 (선택, App 17) — 이 앱(운영자) 쪽이 AWS에 인증하기 위한 값.
# 고객사 계정 정보(Role ARN 등)가 아니라 "우리 회사" AWS 계정 자격증명임에 주의.
# EC2/ECS 인스턴스 역할을 쓴다면 아래는 비워둬도 됨(boto3가 자동으로 인식).
# 자세한 온보딩 절차는 docs/cloudtrail-integration.md 참고.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 백엔드 API 인증 (선택) — 비워두면 지금까지처럼 인증 없이 전체 /api/* 오픈(로컬 개발 기본값).
# n8n 등 외부 자동화 도구에서 이 백엔드를 로컬 밖(다른 호스트/컨테이너)으로 열 때 설정 권장.
# 설정 시 모든 /api/* 요청에 X-API-Key 헤더가 이 값과 일치해야 함 (프론트엔드는 이 헤더를
# 보내지 않으므로, 켜면 프론트 fetch/프록시에도 헤더 추가가 필요함 — docs/n8n-integration.md 참고)
API_KEY=
