ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 로컬 LLM (선택, 폐쇄망/인터넷 차단 환경용) — Ollama/vLLM/LM Studio 등 OpenAI 호환
# `/v1/chat/completions` 엔드포인트를 제공하는 서버가 사내망에 있다면 여기 연결한다.
# ANTHROPIC_API_KEY(또는 인터넷)를 쓸 수 없을 때 자동으로 이 로컬 LLM이 사용되고,
# 이마저 없으면 규칙 기반 오프라인 분석으로 자동 전환된다(코드 수정 불필요).
# 예) Ollama: LOCAL_LLM_BASE_URL=http://localhost:11434/v1, LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# 알림 시스템 (선택) — 아래를 하나도 설정하지 않으면 자동으로 Mock 모드로 동작
# (실제 전송 없이 /api/alerts 로그에만 기록됨)

# Slack: Slack 앱의 Incoming Webhook URL
SLACK_WEBHOOK_URL=

# 이메일: SMTP 서버 정보
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# n8n Webhook: Slack/이메일과 별도로, CRITICAL 탐지 시 구조화된 JSON을 n8n의 Webhook
# 트리거로도 전송 — n8n 쪽에서 Jira 티켓 생성 등 임의의 후속 자동화를 붙일 수 있음
# (docs/n8n-integration.md "8. n8n Push 연동" 참고)
N8N_WEBHOOK_URL=

# CVE 실시간 조회 (선택) — 없어도 NVD 공개 API를 그대로 쓸 수 있으나 요청 한도가
# 30초당 5건으로 제한됨. https://nvd.nist.gov/developers/request-an-api-key 에서 무료 발급,
# 설정 시 30초당 50건으로 늘어남.
NVD_API_KEY=

# 백엔드 API 인증 (선택) — 비워두면 지금까지처럼 인증 없이 전체 /api/* 오픈(로컬 개발 기본값).
# n8n 등 외부 자동화 도구에서 이 백엔드를 로컬 밖(다른 호스트/컨테이너)으로 열 때 설정 권장.
# 설정 시 모든 /api/* 요청에 X-API-Key 헤더가 이 값과 일치해야 함 (프론트엔드는 이 헤더를
# 보내지 않으므로, 켜면 프론트 fetch/프록시에도 헤더 추가가 필요함 — docs/n8n-integration.md 참고)
API_KEY=
